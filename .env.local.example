# Copy to .env.local and fill in. The "explain-labs_claude" bot — a Claude bot
# built specifically for the Explain project — lives on the Tailnet (port 8090),
# so this machine must be on the same Tailnet for the dev-server chat proxy
# (/api/chat in vite.config.ts) to reach it.
#
# Do NOT prefix these with VITE_ — that would inline them into the client bundle.
# They are read server-side only, inside the Vite dev middleware.

EXPLAIN_BOT_URL=http://lucys-mac-mini.tail990503.ts.net:8090
EXPLAIN_BOT_API_KEY=

# --- Auth / cloud states (OPTIONAL for local development) ---
# Leave MONGODB_URI and AUTH_SECRET blank for model development. `npm run dev` then
# runs in local mode: auto-login as the local developer, file snapshots only, and
# no database or SSH tunnel needed. Set them only to work on cloud-saved states,
# admin, or lesson launches.
#
# Full MongoDB connection string INCLUDING the password; the database name is
# taken from the path (e.g. mongodb://user:pass@127.0.0.1:27018/explain?directConnection=true
# through an SSH tunnel). Backs the `users` and `states` collections.
MONGODB_URI=

# Secret used to sign session cookies. Generate one with: openssl rand -base64 32
AUTH_SECRET=
